  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "卯のはなのをりはかりこそ山里のかきねの山は一重みえける",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "つきもせす越のしらねに年積る雪は常盤のものにそありける",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "明方にほのめくこゑは時鳥ねさめのこひのこ〓ちこそすれ",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "ねさめする有明かたの淋しさにさほのかはらの千鳥なく也",
   "kana": "",
   "speaker": "",
