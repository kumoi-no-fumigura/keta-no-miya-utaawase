    33
   ],
   "text": "群書類從卷第百八十二撿技保己-集和歌部卅七歌合三氣多宮歌合延久四年ニ月十九日國司通〓舊本行書躰〕宗朝臣於社頭合之題卯のはなのをりはかりこそ山里のかきねの山は一重みえける雪勝つきもせす越のしらねに年積る雪は常盤のものにそありける郭公明方にほのめくこゑは時鳥ねさめのこひのこ〓ちこそすれ千鳥ねさめする有明かたの淋しさにさほのかはらの千鳥なく也",
   "poems": [
    "1",
    "2",
    "3",
    "4"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "卯のはなのをりはかりこそ山里のかきねの山は一重みえける",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "つきもせす越のしらねに年積る雪は常盤のものにそありける",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "明方にほのめくこゑは時鳥ねさめのこひのこ〓ちこそすれ",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "ねさめする有明かたの淋しさにさほのかはらの千鳥なく也",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
